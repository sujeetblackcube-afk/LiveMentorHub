# Global Root .gitignore for LiveMentorHub Monorepo

# Dependencies
node_modules/
.pnpm-store/
jspm_packages/
web_modules/

# Next.js & Vite Build Outputs
.next/
dist/
out/
build/
*.tsbuildinfo

# Environment Variables & Local Configs
.env
.env.*
.env*.local
*.env
.env.production
.env.staging
.env.development

# Logs & Operating System Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE & Tooling Metadata
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.gemini/

# Documentation & Scratch Files
LiveMentorHub Backend Architecture.docx
*.docx
scratch_doc_text.txt
scratch/
backend/check_*.js
backend/test_*.js

